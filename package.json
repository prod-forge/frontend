{
  "name": "prod-forge-todolist-frontend",
  "version": "1.0.0",
  "description": "Prod Forge frontend: React web client, Expo mobile client and design system built with production practices",
  "homepage": "https://github.com/prod-forge/frontend#readme",
  "bugs": {
    "url": "https://github.com/prod-forge/frontend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prod-forge/frontend.git"
  },
  "license": "MIT",
  "author": "Aleksandrov Sergey <gooddev.sergey@gmail.com>",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "build:web-client": "nx build web-client",
    "design-token:build": "nx run design-tokens:build",
    "dev": "nx serve web-client",
    "dev:assets": "npx serve assets -l 4000",
    "dev:mobile": "nx start mobile-client",
    "doctor": "react-doctor .",
    "format": "nx run-many -t format",
    "full-check": "npm run lint && npm run knip && npm run test && npm run test:e2e && npm run test:visual && npm run test:a11y",
    "knip": "knip",
    "lint": "nx run-many -t lint --output-style=stream",
    "lint:commit": "commitlint --config .commitlintrc.cjs --edit",
    "pre-commit": "lint-staged --config .lintstagedrc.cjs",
    "prepare": "husky",
    "release": "tsx release/before-release.ts && npx release-it",
    "storybook": "nx storybook ui-web",
    "storybook:build": "nx build-storybook ui-web",
    "test": "nx run-many -t test",
    "test:a11y": "nx test:a11y ui-web",
    "test:cov": "nx run-many -t test:cov",
    "test:e2e": "nx test:e2e web-client",
    "test:e2e:cov": "nx test:e2e:cov web-client",
    "test:mobile": "nx test mobile-client",
    "test:visual": "nx test:visual ui-web",
    "test:visual:update": "nx test:visual:update ui-web"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@inquirer/checkbox": "5.2.8",
    "@inquirer/prompts": "8.7.5",
    "@playwright/test": "1.64.1",
    "@release-it/bumper": "7.0.6",
    "@release-it/conventional-changelog": "11.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.14.0",
    "eslint-config-flat-gitignore": "2.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-lite": "0.6.0",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-package-json": "1.14.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-storybook": "10.6.5",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "knip": "6.44.1",
    "lint-staged": "17.6.0",
    "nx": "22.7.12",
    "nyc": "18.0.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-doctor": "0.9.22",
    "react-dom": "19.3.0",
    "release-it": "20.2.1",
    "serve": "14.2.6",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "36.0.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-istanbul": "8.0.0",
    "vitest": "4.1.12"
  }
}
