{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "e2e/**/*",
    "vite.config.mts",
    "vite.build-env.mts",
    "vite.build-env.test.ts",
    "index-csp.test.ts",
    "vitest.setup.ts",
    "playwright.config.ts",
    "playwright.coverage.config.ts"
  ]
}
