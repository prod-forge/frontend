{
  "name": "@prod-forge-todolist-frontend/mobile-client",
  "version": "1.2.2",
  "description": "Expo mobile application (iOS and Android) for prod-forge-todolist-frontend",
  "license": "MIT",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "doctor": "npx expo-doctor",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "format": "npm run format:prettier && npm run format:code",
    "format:code": "eslint . --fix",
    "format:prettier": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "lint": "npm run lint:ts && npm run lint:code",
    "lint:code": "eslint .",
    "lint:ts": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@prod-forge-todolist-frontend/core": "*",
    "@prod-forge-todolist-frontend/design-tokens": "*",
    "@reduxjs/toolkit": "2.11.2",
    "@sentry/react-native": "8.28.0",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-redux": "9.2.0"
  },
  "devDependencies": {
    "@prod-forge-todolist-frontend/test-data": "*",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "babel-jest": "30.5.2",
    "babel-preset-expo": "58.0.24",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "test-renderer": "1.3.0"
  }
}
